# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin Auth ────────────────────────────────────────────────────────────────
# Password used to authenticate admin writes
ADMIN_PASSWORD=your-secure-admin-password
# HMAC signing secret (min 32 chars, different from ADMIN_PASSWORD)
ADMIN_TOKEN_SECRET=your-hmac-secret-minimum-32-characters-here

# ── Storage Provider ─────────────────────────────────────────────────────────
# Selects which storage backend handles uploads, downloads and asset URLs.
# Either "google" (default) or "box". See README.md → "Switching Storage
# Providers" for the full setup steps for each provider.
STORAGE_PROVIDER=google

# ── Google Drive (OAuth 2.0) ──────────────────────────────────────────────────
# Only required when STORAGE_PROVIDER=google
# Root folder ID in the owner's personal Google Drive
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Application type: Web application
# Authorized redirect URI: https://your-domain.com/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret

# Obtained once via GET /api/auth/google/setup (admin login required)
# After authorizing, copy the refresh token shown on screen here
GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token

# ── Box (OAuth 2.0) ───────────────────────────────────────────────────────────
# Only required when STORAGE_PROVIDER=box
# Root folder ID in Box that all uploads are nested under
BOX_ROOT_FOLDER_ID=your-box-folder-id

# Box Developer Console → Create App → Custom App → User Authentication (OAuth 2.0)
# Redirect URI: https://your-domain.com/api/auth/box/callback
BOX_CLIENT_ID=your-box-client-id
BOX_CLIENT_SECRET=your-box-client-secret

# Obtained once via GET /api/auth/box/setup (admin login required)
# After authorizing, copy the refresh token shown on screen here
BOX_REFRESH_TOKEN=your-box-refresh-token

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.com
